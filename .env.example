# Copy to .env.local (gitignored) and fill in. Loaded by scripts/env.sh for
# start-react.sh and build.sh. Nothing here is needed for a plain `cargo run`.
#
# NEVER commit .env.local.

# --- macOS signing + notarization (build.sh without --dev) -------------------
# export APPLE_ID="you@example.com"
# export APPLE_TEAM_ID="YOURTEAMID"
# export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"   # app-specific password
# export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Company (YOURTEAMID)"

# --- License verification -----------------------------------------------------
# Hex-encoded HMAC key used to verify signed plan entitlements from the
# compeller.ai backend. Builds without it still run; they just cannot verify
# signed license blobs.
# export REACT_LICENSE_HMAC_KEY=""

# --- Development backend ------------------------------------------------------
# When set, start-react.sh builds with `--features dev` and talks to this host
# instead of https://compeller.ai. No trailing slash.
# export REACT_DEV_API_HOST="https://dev.example.com"

# --- NDI ----------------------------------------------------------------------
# Location of the NDI SDK (expects lib/libndi.dylib). Defaults to ./ndi-sdk.
# export NDI_SDK_DIR="/path/to/ndi-sdk"
