# Copy to .env.local (gitignored) and fill in. Loaded by scripts/env.sh for
# start-react.sh and build.sh. Nothing here is needed for a plain `cargo run`.
#
# NEVER commit .env.local.

# --- Development backend ------------------------------------------------------
# When set, start-react.sh builds with `--features dev` and talks to this host
# instead of https://compeller.ai. No trailing slash.
# export REACT_DEV_API_HOST="https://dev.example.com"

# --- NDI ----------------------------------------------------------------------
# Location of the NDI SDK (expects lib/libndi.dylib). Defaults to ./ndi-sdk.
# export NDI_SDK_DIR="/path/to/ndi-sdk"
